[sub_resource type="Shader" id="Shader_all_out_idle_highlight"]
code = "shader_type canvas_item;

uniform float sweep_progress : hint_range(-1.0, 1.0) = -1.0;
uniform float band_width : hint_range(0.01, 0.5) = 0.10;
uniform vec4 highlight_color : source_color = vec4(1.0, 0.96, 0.72, 0.52);

void fragment() {
	vec4 source = texture(TEXTURE, UV) * COLOR;
	float sweep_axis = UV.x + (UV.y - 0.5) * 0.18;
	float center = mix(-band_width, 1.0 + band_width, max(sweep_progress, 0.0));
	float distance_to_band = abs(sweep_axis - center);
	float band = 1.0 - smoothstep(band_width * 0.30, band_width * 0.50, distance_to_band);
	band *= step(0.0, sweep_progress) * source.a;
	source.rgb = mix(source.rgb, vec3(1.0), band * highlight_color.a);
	source.rgb += highlight_color.rgb * band * 0.08;
	COLOR = vec4(min(source.rgb, vec3(1.0)), source.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_all_out_idle_highlight"]
resource_local_to_scene = true
shader = SubResource("Shader_all_out_idle_highlight")
shader_parameter/sweep_progress = -1.0
shader_parameter/band_width = 0.1
shader_parameter/highlight_color = Color(1, 0.96, 0.72, 0.52)

