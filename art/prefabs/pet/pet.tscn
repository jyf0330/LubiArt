[sub_resource type="Shader" id="Shader_hit_flash"]
code = "shader_type canvas_item;

uniform float flash_amount : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	vec3 flash_color = vec3(1.0, 0.945, 0.812);
	COLOR = vec4(mix(source.rgb, flash_color, flash_amount), source.a);
}
"

